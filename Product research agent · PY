# ============================================================
#  AGENT CLASS
# ============================================================
class ProductResearchAgent:
    def __init__(self, groq_key: str, model: str, use_tavily: bool):
        all_tools = [search_duckduckgo, search_prices, search_reviews]
        if use_tavily:
            all_tools.insert(1, search_tavily)

        self.tools_dict = {t.name: t for t in all_tools}
        self.llm = ChatGroq(
            model=model,
            temperature=0.1,
            groq_api_key=groq_key,
            max_tokens=4096
        ).bind_tools(all_tools)

    def call_llm(self, state: AgentState) -> dict:
        msgs = [SystemMessage(content=SYSTEM_PROMPT)] + state["messages"]
        response = self.llm.invoke(msgs)
        return {"messages": [response]}

    def take_action(self, state: AgentState) -> dict:
        last = state["messages"][-1]
        outputs = []
        for tc in last.tool_calls:
            name = tc["name"]
            args = tc["args"]
            log_msg = f"🔧 {name}({list(args.values())[0] if args else ''})"
            st.session_state.tool_logs.append(log_msg)

            if name not in self.tools_dict:
                obs = f"Tool '{name}' not found."
            else:
                try:
                    obs = self.tools_dict[name].invoke(args)
                except Exception as e:
                    obs = f"Error: {e}"

            outputs.append(ToolMessage(tool_call_id=tc["id"], content=str(obs)))
        return {"messages": outputs}

    def run(self, query: str, max_iter: int = 8) -> str:
        state: AgentState = {"messages": [HumanMessage(content=query)]}

        for _ in range(max_iter):
            llm_out = self.call_llm(state)
            state["messages"] = state["messages"] + llm_out["messages"]
            last = state["messages"][-1]

            has_calls = hasattr(last, "tool_calls") and len(last.tool_calls) > 0
            if not has_calls:
                return last.content

            act_out = self.take_action(state)
            state["messages"] = state["messages"] + act_out["messages"]

        # Final summarize pass
        final = self.call_llm(state)
        return final["messages"][-1].content

