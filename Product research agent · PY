@tool
def search_duckduckgo(query: str) -> str:
    """Search DuckDuckGo for product information, prices, reviews, and specs."""
    try:
        with DDGS() as ddgs:
            results = list(ddgs.text(query, max_results=6))
        if not results:
            return "No results found on DuckDuckGo."
        parts = []
        for r in results:
            parts.append(f"TITLE: {r.get('title','')}\nINFO: {r.get('body','')}\nURL: {r.get('href','')}")
        return "\n---\n".join(parts)
    except Exception as e:
        return f"DuckDuckGo error: {e}"


@tool
def search_tavily(query: str) -> str:
    """Search Tavily for deep product research, pricing pages, and reviews."""
    try:
        from langchain_community.tools.tavily_search import TavilySearchResults
        key = st.session_state.get("tavily_key", os.environ.get("TAVILY_API_KEY", ""))
        if not key or key.startswith("tvly-YOUR"):
            return "Tavily key not set — skipping Tavily search."
        os.environ["TAVILY_API_KEY"] = key
        tavily = TavilySearchResults(max_results=5)
        results = tavily.invoke(query)
        if not results:
            return "No results from Tavily."
        parts = []
        for r in results:
            parts.append(f"INFO: {r.get('content','')[:400]}\nURL: {r.get('url','')}")
        return "\n---\n".join(parts)
    except Exception as e:
        return f"Tavily error: {e}"


@tool
def search_prices(product: str) -> str:
    """Search for current prices, deals, and where to buy a product."""
    try:
        with DDGS() as ddgs:
            results = list(ddgs.text(f"buy {product} price USD site:amazon.com OR site:walmart.com OR site:bestbuy.com OR site:ebay.com OR site:flipkart.com", max_results=6))
        if not results:
            return "No pricing data found."
        parts = []
        for r in results:
            parts.append(f"STORE: {r.get('title','')}\nDETAILS: {r.get('body','')}\nLINK: {r.get('href','')}")
        return "\n---\n".join(parts)
    except Exception as e:
        return f"Price search error: {e}"


@tool
def search_reviews(product: str) -> str:
    """Search for user reviews, expert opinions, and ratings for a product."""
    try:
        with DDGS() as ddgs:
            results = list(ddgs.text(f"{product} review rating pros cons 2024 2025", max_results=6))
        if not results:
            return "No reviews found."
        parts = []
        for r in results:
            parts.append(f"SOURCE: {r.get('title','')}\nREVIEW: {r.get('body','')}\nURL: {r.get('href','')}")
        return "\n---\n".join(parts)
    except Exception as e:
        return f"Review search error: {e}"

